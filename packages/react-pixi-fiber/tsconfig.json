{
  "compilerOptions": {
    "lib": ["es2015", "dom"],
    "noEmit": true,
    // pixi.js 6 typings conflict with lib.dom in TypeScript 5+ (CanvasRenderingContext2D.letterSpacing)
    "skipLibCheck": true,
    "strict": true,
    "jsx": "react",
    // Required for importing 3rd-party dependencies like EventEmitter3
    "esModuleInterop": true,
    "paths": {
      "react-pixi-fiber": ["./index.d.ts"]
    },
    "types": []
  },
  "files": ["test/typescript/index.tsx"]
}
