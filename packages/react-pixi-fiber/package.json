{
  "name": "react-pixi-fiber",
  "version": "2.0.0-rc.4",
  "description": "React Fiber renderer for PixiJS",
  "main": "index.js",
  "umd:main": "index.umd.js",
  "author": "Michal Ochman",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/michalochman/react-pixi-fiber.git",
    "directory": "packages/react-pixi-fiber"
  },
  "typings": "./index.d.ts",
  "exports": {
    ".": {
      "node": {
        "types": "./index.d.ts",
        "default": "./index.js"
      },
      "import": {
        "types": "./index.d.mts",
        "development": "./dist/es/react-pixi-fiber.development.js",
        "default": "./dist/es/react-pixi-fiber.production.min.js"
      },
      "require": {
        "types": "./index.d.ts",
        "default": "./index.js"
      }
    },
    "./react-pixi-alias": {
      "node": "./react-pixi-alias.js",
      "import": {
        "development": "./dist/es/react-pixi-alias.development.js",
        "default": "./dist/es/react-pixi-alias.production.min.js"
      },
      "require": "./react-pixi-alias.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "LICENSE",
    "README.md",
    "index.d.mts",
    "index.d.ts",
    "index.js",
    "index.umd.js",
    "react-pixi-alias.js",
    "dist/",
    "src/"
  ],
  "sideEffects": false,
  "dependencies": {
    "fbjs": "^3.0.0",
    "react-reconciler": "^0.29.0"
  },
  "peerDependencies": {
    "pixi.js": ">=4.4.0 <8.0.0",
    "prop-types": ">=15.0.0",
    "react": ">=18.2.0",
    "react-dom": ">=18.2.0"
  },
  "devDependencies": {
    "@babel/cli": "^7.21.5",
    "@babel/core": "^7.22.1",
    "@babel/plugin-syntax-dynamic-import": "^7.8.3",
    "@babel/preset-env": "^7.22.4",
    "@babel/preset-react": "^7.22.3",
    "@rollup/plugin-babel": "^6.0.3",
    "@rollup/plugin-commonjs": "^25.0.0",
    "@rollup/plugin-node-resolve": "^15.1.0",
    "@rollup/plugin-replace": "^5.0.2",
    "@types/react": "^18.2.8",
    "babel-plugin-rewire": "^1.2.0",
    "canvas": "^3.2.3",
    "cross-env": "^7.0.3",
    "jest": "^26.6.3",
    "jest-webgl-canvas-mock": "^2.5.0",
    "pixi.js": "^6.0.2",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-test-renderer": "^18.2.0",
    "rollup": "^2.75.6",
    "rollup-plugin-peer-deps-external": "^2.2.4",
    "rollup-plugin-terser": "^7.0.0",
    "rollup-plugin-visualizer": "^5.9.0",
    "typescript": "^7.0.2"
  },
  "scripts": {
    "build": "npm run build:prod && npm run build:dev",
    "build:dev": "cross-env NODE_ENV=development rollup -c config/rollup.config.js",
    "build:prod": "cross-env NODE_ENV=production rollup -c config/rollup.config.js",
    "build:alias:dev": "cross-env NODE_ENV=development rollup -c config/rollup.config.js --environment entry:alias",
    "build:alias:prod": "cross-env NODE_ENV=production rollup -c config/rollup.config.js --environment entry:alias",
    "build:index:dev": "cross-env NODE_ENV=development rollup -c config/rollup.config.js --environment entry:index",
    "build:index:prod": "cross-env NODE_ENV=production rollup -c config/rollup.config.js --environment entry:index",
    "prepublishOnly": "npm run test && npm run build && pnpm -w check-package",
    "test": "npm run test:dev && npm run test:prod",
    "test:cov": "npm run test:dev -- --coverage && npm run test:prod -- --coverage && node mapCoverage.js",
    "test:dev": "jest -c config/jest.dev.json",
    "test:prod": "jest -c config/jest.prod.json",
    "test:ts": "tsc -p tsconfig.json"
  }
}
