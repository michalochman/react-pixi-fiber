{
  "compilerOptions": {
    "lib": ["es2018", "dom"],
    "noEmit": true,
    // pixi.js 5 typings conflict with lib.dom in TypeScript 5+ (CanvasRenderingContext2D.letterSpacing)
    "skipLibCheck": true,
    "strict": true,
    "jsx": "react",
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "paths": {
      "react-pixi-fiber": ["../react-pixi-fiber/src/index.ts"],
      "@react-pixi-fiber/react-18": ["../react-18/src/index.ts"]
    },
    "types": []
  },
  "include": ["src", "test"]
}
