{
  "name": "react-pixi-fiber-workspace",
  "private": true,
  "license": "MIT",
  "type": "module",
  "repository": "github:michalochman/react-pixi-fiber",
  "packageManager": "pnpm@10.24.0",
  "scripts": {
    "build": "pnpm --filter \"./packages/*\" build",
    "test": "pnpm --filter react-pixi-fiber test",
    "lint": "biome check",
    "format": "biome check --write",
    "check-types": "pnpm -r check-types",
    "start": "pnpm --filter examples start",
    "check-package": "node scripts/check-package.mjs",
    "changeset": "changeset",
    "version-packages": "changeset version",
    "release": "pnpm -r build && pnpm check-package && changeset publish"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.5",
    "@biomejs/biome": "2.5.14",
    "@changesets/changelog-github": "^1.0.1",
    "@changesets/cli": "^3.0.3",
    "@vitest/coverage-v8": "4.1.10",
    "canvas": "^3.2.3",
    "cross-env": "^7.0.3",
    "esbuild": "^0.28.2",
    "jsdom": "28.1.0",
    "publint": "^0.3.24",
    "rolldown": "1.1.5",
    "tsdown": "0.22.8",
    "typescript": "^7.0.2",
    "vitest": "4.1.10",
    "vitest-webgl-canvas-mock": "1.1.0"
  }
}
