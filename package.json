{
  "name": "react-pixi-fiber-workspace",
  "private": true,
  "license": "MIT",
  "repository": "github:michalochman/react-pixi-fiber",
  "packageManager": "pnpm@10.24.0",
  "scripts": {
    "build": "pnpm --filter react-pixi-fiber build",
    "test": "pnpm --filter react-pixi-fiber test",
    "eslint": "pnpm --filter react-pixi-fiber eslint",
    "check-types": "pnpm --filter react-pixi-fiber test:ts && pnpm --filter examples check-types",
    "start": "pnpm --filter examples start"
  }
}
